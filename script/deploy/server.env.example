# =============================================================================
# StoryForge 远程部署目标配置（模板）
#
#   用法：cp server.env.example server.env 后按实际情况填写。
#   server.env 含真实服务器信息，已在 .gitignore 中排除，不要提交。
# =============================================================================

# 服务器公网 IP
HOST=1.2.3.4

# SSH 用户名（腾讯云轻量 OpenCloudOS 镜像为 root）
USER=root

# SSH 端口
SSH_PORT=22

# SSH 私钥路径（相对本文件所在目录，或绝对路径；路径含空格时无需引号，脚本内部会引用）
KEY=../../../secret/cloud_service_ssh.pem

# 服务器上的部署目录
REMOTE_DIR=/opt/storyforge

# 对外端口（服务器防火墙 / 腾讯云轻量控制台防火墙需放行）
APP_PORT=8080

# 容器内 JVM 堆（2G 内存机器建议不超过 768m）
JAVA_OPTS="-Xms128m -Xmx640m"

# -----------------------------------------------------------------------------
# 镜像仓库（腾讯云 TCR 个人版，可换成 Docker Hub / 阿里云 ACR 等）
#   build.sh 用它决定推送地址；deploy.sh --from-registry 用它决定拉取地址。
#   命名空间与仓库名需先在对应平台创建。
# -----------------------------------------------------------------------------
REGISTRY=ccr.ccs.tencentyun.com
IMAGE_NAME=<your-namespace>/story-forge
# 镜像标签：留空 = 取 pom.xml 的版本（推荐）；也可填固定标签
IMAGE_TAG=
# 仓库登录用户名（腾讯云为账号 ID）；密码不落盘，走 TCR_PASSWORD 或 secret/tcr-password.txt
REGISTRY_USER=<your-registry-username>
