# 复制为 .env 后按需修改：cp .env.example .env

# 对外服务端口
APP_PORT=8080

# PostgreSQL
DB_NAME=storyforge
DB_USER=storyforge
DB_PASSWORD=change_me_postgres

# JWT 签名密钥：必须 >= 32 字节，请替换为随机值
# 生成示例：openssl rand -base64 48
STORYFORGE_JWT_SECRET=please_replace_with_a_random_secret_at_least_32_bytes

# 敏感字段加密主密钥（AI API Key 等）。必须替换为随机值，且**不可随意更换**：
# 更换后已落库的密文将无法解密（表现为「密钥解密失败，请重新填写 API Key」）。
STORYFORGE_SECRET_KEY=please_replace_with_another_random_secret_value

# 初始超级管理员（仅首次启动创建；force-change=true 时首登必须改密）
STORYFORGE_ADMIN_USERNAME=admin
STORYFORGE_ADMIN_PASSWORD=Admin@123456
STORYFORGE_ADMIN_FORCE_CHANGE=true

# JVM 参数
JAVA_OPTS=-Xms256m -Xmx1024m

# 小说封面目录（容器内固定 /data/covers，已由 docker-compose 挂载到 ./data/covers；
# 如需换宿主机位置，改 docker-compose.yml 的 volumes 左侧即可，不要改这里的容器内路径）
# STORYFORGE_COVER_ROOT=/data/covers
